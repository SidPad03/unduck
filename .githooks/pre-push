#!/bin/bash
# Refuse to push main unless the installer for the current VERSION is committed
# under releases/.
#
# publish.yml does no compiling - it publishes whatever is in releases/. So a
# push that bumps VERSION without the matching build would produce a release
# that either fails or ships the previous version's installer. This catches that
# before it leaves the machine.
#
# Enable it with:  scripts/setup-hooks.sh   (sets core.hooksPath to .githooks)
# Bypass it with:  git push --no-verify     (for docs-only work on a dirty tree)
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
FAILED=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
    # Only guard main; branches and tags are unaffected.
    [ "$remote_ref" = "refs/heads/main" ] || continue
    # Branch deletion - nothing to check.
    [ "$local_sha" = "$ZERO" ] && continue

    VERSION="$(git show "$local_sha:VERSION" 2>/dev/null | tr -d '[:space:]')"
    if [ -z "$VERSION" ]; then
        echo "pre-push: could not read VERSION at $local_sha; skipping the release check." >&2
        continue
    fi

    DMG="releases/Unduck-${VERSION}.dmg"
    PKG="releases/Unduck-${VERSION}.pkg"

    # Check the commit being pushed, not the working tree: a file sitting
    # untracked on disk would still break the release.
    if ! git cat-file -e "$local_sha:$DMG" 2>/dev/null; then
        echo "" >&2
        echo "  BLOCKED: $DMG is not committed." >&2
        echo "" >&2
        echo "  VERSION says $VERSION, but the installer for it is not in the commit" >&2
        echo "  you are pushing. Publishing would fail or ship the wrong build." >&2
        echo "" >&2
        echo "  Fix it with:" >&2
        echo "    scripts/publish.sh            # build, commit, push and publish" >&2
        echo "" >&2
        echo "  Or build and commit by hand:" >&2
        echo "    scripts/build-dmg.sh $VERSION" >&2
        echo "    git add releases/Unduck-$VERSION.*" >&2
        echo "" >&2
        echo "  In the commit being pushed, releases/ currently holds:" >&2
        git ls-tree --name-only "$local_sha:releases" 2>/dev/null | sed 's/^/    /' >&2 \
            || echo "    (no releases/ folder)" >&2
        echo "" >&2
        echo "  Docs-only change? Push with --no-verify." >&2
        echo "" >&2
        FAILED=1
        continue
    fi

    # The updater prefers the .pkg for a one-click install, but falls back to the
    # .dmg, so a missing .pkg is a warning rather than a block.
    if ! git cat-file -e "$local_sha:$PKG" 2>/dev/null; then
        echo "pre-push: note - $PKG is not committed; updates will fall back to the .dmg." >&2
    fi
done

if [ "$FAILED" -ne 0 ]; then
    exit 1
fi
exit 0
